# ====================================================================
# ENVIRONMENT VARIABLES TEMPLATE (PHASE 4 - AUTHENTICATION & RBAC)
# Copy this file to .env and replace placeholder values with your own.
# DO NOT COMMIT REAL CREDENTIALS TO GIT.
# ====================================================================

# Supabase PostgreSQL Database Configuration
DB_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
DB_USERNAME=YOUR_DATABASE_USERNAME
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Supabase Auth & Project Keys (Optional for Spring Boot standalone auth)
SUPABASE_URL=https://YOUR_SUPABASE_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# JWT Configuration (Minimum 256-bit secret key for HMAC-SHA256)
JWT_SECRET=your_super_secret_jwt_key_that_is_at_least_32_bytes_long_2026!
JWT_EXPIRATION_MS=86400000

# Platform Initial Admin Setup
ADMIN_EMAIL=admin@farmersmarket.local
ADMIN_PASSWORD=ChangeThisAdminPassword2026!

# Spring Boot Server Settings & CORS
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
