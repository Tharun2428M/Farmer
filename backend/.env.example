# =================================================================
# SPRING BOOT BACKEND ENVIRONMENT CONFIGURATION (SUPABASE + JWT)
# =================================================================

# Server Port
PORT=8080
SERVER_PORT=8080

# Supabase PostgreSQL Database Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://db.<supabase-project-id>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_supabase_database_password

# JPA / Hibernate
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_PROPERTIES_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# JWT Security Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Configuration (Comma-separated allowed origins)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.vercel.app
